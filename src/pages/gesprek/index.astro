</style>

<style is:global>
  /* Het klikbare videoblok dat de quiz opent, en de quiz-popup zelf. */
  .video-start {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-top: 32px;
    border: none;
    border-radius: 8px;
    background: linear-gradient(150deg, #10241C, #0A1512);
    cursor: pointer;
    transition: transform 0.16s ease;
  }
  .video-start:hover { transform: translateY(-2px); }
  .video-start:hover .video-ph-play { border-color: #fff; }
  .quiz-overlay {
    position: fixed;
    inset: 0;
    /* Boven de cookiebalk (die staat op 9999), anders vangt die de klikken
       op de onderste knoppen van de popup af. */
    z-index: 10000;
    background: rgba(10, 10, 9, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .quiz-overlay[hidden] { display: none; }
  .quiz-venster {
    position: relative;
    width: 100%;
    max-width: 512px;
    max-height: calc(100dvh - 32px);
    background: #fff;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 20px 40px -12px rgba(10, 10, 9, 0.35);
  }
  .quiz-venster .kaart {
    border: none;
    padding: 0 8px;
    /* Zijn venster houdt vanaf stap twee dezelfde hoogte, ook als er minder
       antwoorden onder een vraag staan. Nagemeten op de langste stap. */
    min-height: 340px;
    max-height: calc(100dvh - 260px);
    overflow-y: auto;
  }
  /* Zijn sluitknop hangt over de hoek van het venster, 40 bij 40. */
  .quiz-sluit {
    position: absolute;
    top: -16px;
    right: -16px;
    z-index: 2;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    background: #fff;
    color: #404040;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.12), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
  }
  .quiz-sluit:hover { background: #fafaf8; color: #000; }
  @media (max-width: 480px) {
    .quiz-venster { padding: 16px; }
    .quiz-venster .kaart { padding: 0; min-height: 300px; max-height: calc(100dvh - 230px); }
    .quiz-sluit { top: -14px; right: -6px; width: 36px; height: 36px; }
  }
</style>

<style>
  .stap-regel { font-size: 16.5px; font-weight: 600; color: #3C3C39; margin: 18px 0 14px; text-align: center; }
</style>
