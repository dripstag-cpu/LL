  }
  .stemmen .sterren { color: #E8B93F; letter-spacing: 2px; font-size: 15px; margin-bottom: 10px; }
  .stemmen blockquote { margin: 0 0 12px; font-size: 15px; line-height: 1.6; color: #3C3C39; }
  .stemmen figcaption { display: flex; gap: 10px; align-items: baseline; }
  .stemmen figcaption b { font-family: 'Outfit Variable', sans-serif; font-size: 14.5px; }
  .stemmen figcaption span { font-size: 13px; color: #8C8C87; }
  @media (max-width: 700px) {
    .stemmen { margin: 48px auto 56px; }
