---
// Onderdeel-pagina's, toegevoegd 2026-08-16. Eén template voor alle
// onderdelen van het pakket, data in src/data/onderdelen.js.
//
// Waarom deze pagina's bestaan: dit is de SEO-laag onder /prijs/ en /gesprek/.
// De branchetermen zijn bezet door gespecialiseerde bureaus, de probleemtermen
// (hoger in Google Maps, meer reviews, gemiste oproep) alleen door
// blogartikelen. Elke pagina staat op één zo'n term.
//
// OPBOUW, herzien 2026-08-17 naar de productpagina van het voorbeeld dat we
// aanhouden (doc 51). Vijf stappen, en dan is de pagina klaar:
//   1. H1 met de productnaam, groot en gecentreerd
//   2. de cursieve regel met de klap erin, plus de knop
//   3. de kop boven de feiten, met drie feiten-kaartjes eronder
//   4. "Wat is <naam>?" in gewone taal, en daaronder vier voordeelblokken
//   5. klaar
//
// Wat er in die herziening uit ging: het losse blok met de grens (staat nu in
// de laatste alinea van `wat`), de pakketkaart met de prijs (staat op /prijs/,
// waar de voettekst naar linkt) en de lijst met de andere onderdelen (staat in
// de voettekst, net als bij hem). Het proces, de reviews en de slotkaart komen
// uit SiteFooter.astro en staan hier dus niet nog een keer.
//
// AFWIJKING VAN ZIJN PAGINA, met reden. Hij zet naast een video drie
// percentages over hoeveel mensen een website beoordelen. Wij zetten geen
// percentages neer en geen video: onder de kop staan drie feiten-kaartjes uit
// `feiten` in onderdelen.js, over de volle breedte naast elkaar (op smal scherm
// onder elkaar). De getekende product-voorbeelden die hier eerst stonden zitten
// nog in onderdelen.js.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import { onderdelen } from '../../data/onderdelen.js';

export function getStaticPaths() {
  return onderdelen.map((o) => ({ params: { onderdeel: o.slug }, props: { o } }));
}

const { o } = Astro.props;

const feitenKop = 'Wat je krijgt';
---

<Layout title={o.title} description={o.description}>
  <SiteNav />

  <main class="od">
    <section class="od-hero">
      <div class="od-inner">
        <h1>{o.naam}</h1>
        <p class="od-regel">{o.regel}</p>
        <a data-cta={`onderdeel-${o.slug}`} class="od-knop" href="/gesprek/">Plan een gesprek</a>
      </div>
    </section>

    <section class="od-demo">
      <div class="od-inner">
        <div class="od-demo-kaart">
          <h2>{feitenKop}</h2>

          {o.feiten && (
            <div class="od-feiten">
              {o.feiten.map((f) => (
                <div class="od-feit">
                  <b>{f.k}</b>
                  <p>{f.t}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="od-uitleg">
      <div class="od-inner">
        {o.secties ? (
          o.secties.map((s) => (
            <div class="od-sectie">
              <h2>{s.h}</h2>
              <div class="od-proza">
                {s.p.map((t) => <p>{t}</p>)}
              </div>
            </div>
          ))
        ) : (
          <Fragment>
            <h2>Wat is {o.naam}?</h2>
            <div class="od-proza">
              {o.wat.map((p) => <p>{p}</p>)}
            </div>

            <div class="od-blokken">
              {o.blokken.map((b) => (
                <article>
                  <h3>{b.h}</h3>
                  <p>{b.p}</p>
                </article>
              ))}
            </div>
          </Fragment>
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
  .od { background: #fafaf8; color: #141413; font-family: 'Plus Jakarta Sans Variable', system-ui, sans-serif; }
  .od-inner { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

  /* ---- 1 en 2: kop, cursieve regel, knop ---- */
  .od-hero { padding: 72px 0 44px; text-align: center; }
  .od h1 {
    font-family: 'Outfit Variable', sans-serif;
    font-size: clamp(34px, 5.4vw, 50px);
    font-weight: 800; line-height: 1.08; letter-spacing: -.03em; margin: 0;
  }
  .od-regel {
    font-style: italic; font-size: clamp(17px, 2vw, 20px); line-height: 1.55;
    color: #3c3c39; margin: 20px auto 0; max-width: 58ch;
  }
  .od-knop {
    display: inline-flex; align-items: center; gap: 9px; margin-top: 30px;
    background: var(--green); color: #fff; font-family: 'Outfit Variable', sans-serif;
    font-weight: 600; font-size: 17px; letter-spacing: -.005em;
    padding: 16px 32px; border-radius: 4px; text-decoration: none;
    transition: background .16s ease;
  }
  .od-knop:hover { background: #1f9067; }

  /* ---- 3: de demo ---- */
  .od-demo { padding: 0 0 76px; }
  .od-demo-kaart { background: #fff; border: 1px solid #e4e3dc; border-radius: 8px; padding: 40px; }
  .od-demo-kaart h2 {
    font-family: 'Outfit Variable', sans-serif; font-size: clamp(22px, 3.2vw, 34px);
    font-weight: 800; letter-spacing: -.02em; line-height: 1.15; margin: 0 0 28px; text-align: center;
  }
  .od-onder { font-size: 15px; line-height: 1.62; color: #64645f; margin: 20px auto 0; max-width: 72ch; text-align: center; }

  .od-voorbeeld-kop {
    padding: 12px 20px; border-bottom: 1px solid #e4e3dc; background: #f7f7f4;
    font-family: 'Outfit Variable', sans-serif; font-weight: 700; font-size: 12px;
    letter-spacing: .12em; text-transform: uppercase; color: #64645f;
  }

  .od-gesprek { padding: 26px 22px; display: flex; flex-direction: column; gap: 12px; }
  .od-bericht { margin: 0; max-width: 80%; padding: 13px 16px; font-size: 15px; line-height: 1.55; border-radius: 16px; }
  .od-bericht--wij { align-self: flex-start; background: #eef3f0; border: 1px solid #dfe8e3; color: #1f1f1d; border-bottom-left-radius: 5px; }
  .od-bericht--klant { align-self: flex-end; background: var(--green); color: #fff; border-bottom-right-radius: 5px; }

  .od-meting { padding: 30px 22px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 30px 44px; }
  .od-raster { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
  .od-punt { display: inline-block; width: 20px; height: 20px; border-radius: 50%; }
  .od-punt--goed { background: var(--green); }
  .od-punt--matig { background: #d8a63c; }
  .od-punt--zwak { background: #c25c4f; }
  .od-legenda { list-style: none; margin: 0; padding: 0; }
  .od-legenda li { display: flex; align-items: center; gap: 10px; font-size: 15px; color: #3c3c39; margin-bottom: 12px; }
  .od-legenda li:last-child { margin-bottom: 0; }

  .od-rijen { list-style: none; margin: 0; padding: 8px 0; }
  .od-rijen li { display: block; padding: 15px 22px; border-bottom: 1px solid #eeede6; }
  .od-rijen li:last-child { border-bottom: 0; }
  .od-rij-kop { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; }
  .od-rij-titel { font-family: 'Outfit Variable', sans-serif; font-weight: 700; font-size: 15px; color: #141413; }
  .od-rij-bij { font-size: 13px; color: #8c8c87; }
  .od-rij-merk { font-size: 11.5px; font-weight: 600; color: var(--green); background: #eaf2ee; border-radius: 999px; padding: 4px 10px; }
  .od-rij-tekst { display: block; margin-top: 5px; font-size: 15px; line-height: 1.5; color: #3c3c39; }

  .od-opbouw { list-style: none; margin: 0; padding: 22px; display: grid; gap: 10px; }
  .od-opbouw li { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; border: 1px dashed #d9d8d0; border-radius: 8px; padding: 14px 16px; background: #fff; }
  .od-opbouw-blok { font-family: 'Outfit Variable', sans-serif; font-weight: 700; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #64645f; background: #f0efe9; border-radius: 999px; padding: 5px 10px; }
  .od-opbouw-blok--reviews, .od-opbouw-blok--knop { color: #fff; background: var(--green); }
  .od-opbouw-tekst { font-size: 15px; color: #3c3c39; }

  /* ---- 4: wat is het, en de vier voordelen ----
     Het donkere blok met de knik erboven en eronder komt van zijn pagina. */
  .od-uitleg {
    background: var(--dark); color: var(--color-foreground);
    padding: 152px 0 156px; margin-top: -1px;
    clip-path: polygon(0 0, 50% 88px, 100% 0, 100% calc(100% - 88px), 50% 100%, 0 calc(100% - 88px));
  }
  .od-uitleg h2 {
    font-family: 'Outfit Variable', sans-serif; font-size: clamp(26px, 4.2vw, 44px);
    font-weight: 800; letter-spacing: -.03em; line-height: 1.12; margin: 0; text-align: center;
    color: var(--color-foreground);
  }
  .od-proza { margin: 26px auto 0; max-width: 70ch; text-align: center; }
  .od-proza p { font-size: 17px; line-height: 1.66; color: var(--light-muted); margin: 0 0 14px; }
  .od-proza p:last-child { margin-bottom: 0; }

  .od-blokken { display: grid; gap: 20px; margin-top: 44px; }
  .od-blokken article { background: #fff; border-radius: 8px; padding: 34px 32px; }
  .od-blokken h3 {
    font-family: 'Outfit Variable', sans-serif; font-size: clamp(20px, 2.4vw, 24px);
    font-weight: 700; color: var(--green); margin: 0 0 12px; line-height: 1.25; letter-spacing: -.015em;
  }
  .od-blokken p { font-size: 16.5px; line-height: 1.6; color: #3c3c39; margin: 0; }

  @media (min-width: 760px) {
    .od-blokken { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .od-demo-kaart { padding: 22px 18px; }
    .od-uitleg { padding: 96px 0 100px; clip-path: polygon(0 0, 50% 36px, 100% 0, 100% calc(100% - 36px), 50% 100%, 0 calc(100% - 36px)); }
    .od-bericht { max-width: 92%; }
  }
</style>

<style>
  /* Benoemde werking-secties, de opbouw van de productpagina's van het
     voorbeeld (doc 51b): per sectie een kop en een paar alinea's. Een
     onderdeel dat `secties` heeft in onderdelen.js gebruikt deze vorm; de
     andere houden "Wat is X" met de vier blokken tot ze omgezet zijn. */
  .od-sectie + .od-sectie { margin-top: 52px; }
</style>

<style>
  /* Drie feiten-kaartjes over de volle breedte, drie kolommen naast elkaar,
     op smal scherm onder elkaar. De inhoud komt uit `feiten` in onderdelen.js
     (doc 49): productfeiten, geen percentages zonder bron. Radius 8, rand
     #e4e3dc, kop 18px. */
  .od-feiten { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .od-feit {
    background: #fafaf8;
    border: 1px solid #e4e3dc;
    border-radius: 8px;
    padding: 24px 22px;
  }
  .od-feit b {
    font-family: 'Outfit Variable', sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .od-feit p { margin: 8px 0 0; font-size: 14.5px; line-height: 1.55; color: #64645f; }
  @media (max-width: 760px) {
    .od-feiten { grid-template-columns: 1fr; }
  }
</style>
