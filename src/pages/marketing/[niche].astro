---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import { niches, nicheGroups } from '../../data/niches.js';
import { topics } from '../../data/topics.js';
import { metaDescription, pageTitle } from '../../utils/meta.js';

export function getStaticPaths() {
  // Alleen gepubliceerde branches bouwen; gearchiveerde (klinieken, beauty,
  // makelaars) krijgen geen losse URL meer (doc 53, 2026-08-18).
  return niches.filter((n) => n.published !== false).map((n) => ({ params: { niche: n.slug }, props: { n } }));
}

const { n } = Astro.props;
const title = pageTitle(n);
const description = metaDescription(n.intro);

// Vaste prijsvraag, achter de branche-eigen vragen. Op één plek onderhouden,
// staat zo op elke branchepagina en in het FAQPage-schema hieronder.
// Bedrag, termijn en inhoud komen uit doc 49: één pakket, prijs mag publiek.
// Losse diensten staan er positief bij, als bij te bestellen
// van oude klanten zijn losse diensten. Prijzen die nog niet vaststaan
// (extra vestiging, geavanceerde SEO) worden hier niet genoemd.
const prijsFaq = {
  q: 'Wat kost het, en wat zit er in dat bedrag?',
  a: '€397 ex btw per maand, geen opstartkosten, maandelijks opzegbaar. Daarin zit alles: je Google Bedrijfsprofiel onderhouden op je winstgevende dienst, je gegevens gelijk op Bing Places en Apple Business Connect, je zichtbaarheid in AI-zoekhulpen zoals ChatGPT en Perplexity gemeten, en elke maand een rapport met een kaart van je stad waarop je ziet waar je staat, met een ingesproken toelichting. Daarbij het review-systeem op je bestaande klantenlijst, waarbij tevreden klanten meteen doorgaan naar je profiel en wie iets aan te merken heeft eerst bij jou terechtkomt, met de link naar je profiel er nog steeds bij, en elke review wordt beantwoord. En je website met hosting, een chat die de meeste vragen meteen beantwoordt en de juiste afspraak-link geeft, een terugbelbericht als je een oproep mist, en automatisch antwoord op berichten via Facebook en Instagram. De website is in bruikleen zolang je klant bent en kun je bij beëindiging afkopen voor €1.000. Bevalt de eerste maand je niet, dan krijg je hem terug. Los bij te bestellen: Google Ads-beheer voor €250 per maand ex advertentiebudget, en het terughalen van je oude klanten als apart traject.',
};
const faq = [...n.faq, prijsFaq];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
// Alleen linken binnen dezelfde inhoudelijke groep, niet naar alle andere
// branches (SOP vindbaarheid 3.4: geen links tussen losse clusters).
const others = niches.filter((x) => x.slug !== n.slug && x.group === n.group);
// Vaste lijst gidsartikelen bij deze branche, alleen wat ook echt gepubliceerd is.
const guides = (n.guides || [])
  .map((slug) => topics.find((t) => t.slug === slug && t.published))
  .filter(Boolean);
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  </Fragment>

  <SiteNav />

  <main class="pg">
    <section class="pg-hero">
      <div class="pg-inner">
        <p class="pg-eyebrow">Voor {n.label}</p>
        <h1>{n.h1}</h1>
        <p class="pg-lead">{n.intro}</p>
        <a data-cta={`branche-${n.slug}`} href="/gesprek/" class="pg-cta">Plan een gesprek</a>
        <p class="pg-note">€397 ex btw per maand. Geen opstartkosten, maandelijks opzegbaar.</p>
      </div>
    </section>

    <section class="pg-block">
      <div class="pg-inner">
        <h2>Waar {n.label} klanten laten liggen</h2>
        <div class="pg-cards">
          {n.pains.map((pain) => (
            <article>
              <h3>{pain.h}</h3>
              <p>{pain.p}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pg-block">
      <div class="pg-inner">
        <h2>Hoe wij het oplossen</h2>
        <div class="pg-pillars">
          <div>
            <span class="pg-pnum">01</span>
            <h3>Gevonden worden</h3>
            <p>Je Google Bedrijfsprofiel onderhouden op je winstgevende dienst, je gegevens gelijk op Bing Places en Apple Business Connect, en je zichtbaarheid in AI-zoekhulpen zoals ChatGPT en Perplexity gemeten. Elke maand een rapport met een kaart van je stad waarop je ziet waar je staat.</p>
          </div>
          <div>
            <span class="pg-pnum">02</span>
            <h3>Gekozen worden</h3>
            <p>Je bestaande klanten krijgen op het juiste moment de vraag hoe het ging. Wie tevreden is gaat meteen door naar je profiel, wie iets aan te merken heeft komt eerst bij jou, met de link naar je profiel er nog steeds bij. Elke review wordt beantwoord.</p>
          </div>
          <div>
            <span class="pg-pnum">03</span>
            <h3>Geboekt worden</h3>
            <p>Een website met hosting, een chat die de meeste vragen meteen beantwoordt en de aanvraag vastlegt, een terugbelbericht als je een oproep mist, en automatisch antwoord op berichten via Facebook en Instagram.</p>
            <p class="pg-pnote">Je agenda blijft van jou. Heb je een eigen boekingssysteem, dan raken we dat niet aan.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pg-block">
      <div class="pg-inner pg-faq">
        <h2>Veelgestelde vragen</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    {guides.length > 0 && (
      <section class="pg-block">
        <div class="pg-inner">
          <h2>Uitleg die hierbij hoort</h2>
          <p class="pg-lead">Wil je eerst weten hoe het werkt? Deze gidsen leggen de onderdelen uit die voor {n.label} het zwaarst wegen.</p>
          <ul class="pg-guides">
            {guides.map((t) => (
              <li>
                <a href={`/gids/${t.slug}/`}>
                  <span class="pg-guide-title">{t.h1}</span>
                  <span class="pg-guide-arrow">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="pg-links"><a href="/gids/">Alle {topics.length} gidsen in de kennisbank &rarr;</a></p>
        </div>
      </section>
    )}

    <section class="pg-block pg-cta-block">
      <div class="pg-inner">
        <h2>Wat het kost</h2>
        <p class="pg-lead">€397 ex btw per maand voor het hele systeem: je vindbaarheid, je reviews en je website met de opvolging eromheen. Geen opstartkosten, maandelijks opzegbaar. Bevalt de eerste maand je niet, dan krijg je hem terug.</p>
        <a data-cta={`branche-slot-${n.slug}`} href="/gesprek/" class="pg-cta">Plan een gesprek</a>
      </div>
    </section>

  </main>
</Layout>

<style>
  .pg { background: #FAFAF8; color: #0a0a09; font-family: 'Plus Jakarta Sans Variable', system-ui, sans-serif; }
  .pg-inner { max-width: 940px; margin: 0 auto; padding: 0 24px; }
  .pg-hero { padding: 56px 0 64px; background: radial-gradient(700px circle at 80% 0%, rgba(26,122,84,0.08), transparent 55%), radial-gradient(500px circle at 0% 100%, rgba(26,122,84,0.06), transparent 60%), #FAFAF8; }
  .pg-eyebrow { font-family: 'Outfit Variable', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #1A7A54; }
  .pg h1 { font-family: 'Outfit Variable', sans-serif; font-size: clamp(32px, 5vw, 52px); font-weight: 800; line-height: 1.08; letter-spacing: -0.02em; margin: 14px 0 0; max-width: 18ch; }
  .pg-lead { font-size: 17px; line-height: 1.6; color: #64645F; margin-top: 18px; max-width: 62ch; }
  .pg-cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 26px; background: var(--green); color: #fff; font-family: 'Outfit Variable', sans-serif; font-weight: 700; font-size: 16px; padding: 16px 28px; border-radius: 14px; text-decoration: none; }
  .pg-note { margin-top: 12px; font-size: 13px; color: #8c8c87; }
  .pg-block { padding: 60px 0; border-top: 1px solid #E4E3DC; }
  .pg h2 { font-family: 'Outfit Variable', sans-serif; font-size: clamp(26px, 3.5vw, 36px); font-weight: 800; letter-spacing: -0.015em; line-height: 1.15; margin: 0; }
  .pg-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 30px; }
  .pg-cards article { border: 1px solid #E4E3DC; border-radius: 16px; padding: 24px; background: #FFFFFF; }
  .pg-cards h3 { font-family: 'Outfit Variable', sans-serif; font-size: 17px; font-weight: 700; color: #0a0a09; margin: 0 0 10px; line-height: 1.25; }
  .pg-cards p { font-size: 14px; line-height: 1.6; color: #64645F; margin: 0; }
  .pg-pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 30px; }
  .pg-pnum { font-family: 'Outfit Variable', sans-serif; font-weight: 800; font-size: 14px; color: #1A7A54; }
  .pg-pillars h3 { font-family: 'Outfit Variable', sans-serif; font-size: 20px; font-weight: 700; color: #0a0a09; margin: 8px 0 8px; }
  .pg-pillars p { font-size: 14.5px; line-height: 1.6; color: #64645F; margin: 0; }
  .pg-pillars .pg-pnote { margin-top: 14px; padding-top: 12px; border-top: 1px dashed #E4E3DC; font-size: 13px; color: #8c8c87; }
  .pg-faq details { border-top: 1px solid #E4E3DC; padding: 18px 0; }
  .pg-faq summary { font-family: 'Outfit Variable', sans-serif; font-weight: 700; font-size: 17px; color: #0a0a09; cursor: pointer; }
  .pg-faq p { font-size: 14.5px; line-height: 1.6; color: #64645F; margin: 12px 0 0; }
  .pg-guides { list-style: none; padding: 0; margin: 26px 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .pg-guides a { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 100%; border: 1px solid #E4E3DC; border-radius: 16px; background: #FFFFFF; padding: 18px 20px; text-decoration: none; }
  .pg-guides a:hover { border-color: #1A7A54; }
  .pg-guide-title { font-family: 'Outfit Variable', sans-serif; font-weight: 700; font-size: 15px; line-height: 1.3; color: #0a0a09; }
  .pg-guide-arrow { color: #1A7A54; font-size: 15px; }
  .pg-block .pg-links { margin-top: 20px; font-size: 14px; color: #64645F; }
  .pg-block .pg-links a { color: #1A7A54; text-decoration: none; }
  .pg-cta-block .pg-lead { margin-top: 16px; }
  .pg-footer { padding: 40px 0 64px; border-top: 1px solid #E4E3DC; font-size: 13px; color: #8c8c87; }
  .pg-links { margin-top: 8px; }
  .pg-links a { color: #64645F; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 720px) { .pg-cards, .pg-pillars, .pg-guides { grid-template-columns: 1fr; } }
</style>
