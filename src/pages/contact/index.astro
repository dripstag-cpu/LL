---
// Contactpagina, toegevoegd 2026-08-17.
//
// Waarom deze pagina bestaat: het e-mailadres stond alleen in de voettekst en
// in de privacyverklaring, en het WhatsApp-nummer alleen verstopt in een knop
// op /gesprek/. Wie contact zoekt via het menu kwam nergens uit.
//
// OPBOUW, 2026-08-17. Zijn /contact is geen contactpagina maar een tweede
// funnel-pagina met de prijs in de kop en een video eronder. Dat is bij ons
// /gesprek/. Deze pagina blijft dus gewoon een contactpagina, en hij blijft
// kort: hoe je ons bereikt, en de bedrijfsgegevens. De blokken die hier stonden
// over waarom een gesprek sneller is, zijn weg; die staan in de slotkaart uit
// SiteFooter.astro en op /gesprek/ zelf.
//
// REGELS DIE HIER GELDEN
// - Geen prijs op deze pagina. Die staat op /prijs/ en /gesprek/.
// - Geen reactietijd beloven. Er is niemand die dat kan garanderen en het is
//   nergens vastgelegd, dus er staat alleen wie er antwoordt.
// - Eén CTA: "Plan een gesprek" naar /gesprek/, met data-cta. De mail- en
//   WhatsApp-links zijn contactgegevens, geen tweede aanbod.
// - KvK-nummer komt uit /voorwaarden/ en /privacy/. Wijzigt het daar, dan hier
//   ook.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';

const EMAIL = 'info@locallevers.com';
const TELEFOON = '+31 6 34014177';
const WHATSAPP = 'https://wa.me/31634014177';
const KVK = '72087986';

const title = 'Contact opnemen met Local Levers | Local Levers';
const description = `Mail naar ${EMAIL}, stuur een bericht via WhatsApp op ${TELEFOON}, of plan meteen een gesprek van twintig minuten.`;
---

<Layout title={title} description={description}>
  <SiteNav />

  <main class="ct">
    <section class="ct-hero">
      <div class="ct-inner">
        <h1>Zo bereik je ons</h1>
        <p class="ct-regel">
          Je krijgt antwoord van Bryan zelf. Kies de weg die jou het beste uitkomt.
        </p>
        <a data-cta="contact-hero" class="ct-knop" href="/gesprek/">Plan een gesprek</a>
      </div>
    </section>

    <section class="ct-blok">
      <div class="ct-inner">
        <div class="ct-wegen">
          <div class="ct-weg">
            <h2>E-mail</h2>
            <p>Voor vragen die geen haast hebben, of als je iets wilt meesturen.</p>
            <a class="ct-groot" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          </div>

          <div class="ct-weg">
            <h2>WhatsApp</h2>
            <p>Voor een korte vraag. Appen mag, bellen mag ook.</p>
            <a class="ct-groot" href={WHATSAPP} target="_blank" rel="noopener">{TELEFOON}</a>
          </div>
        </div>

        <ul class="ct-gegevens">
          <li><span>Bedrijf</span> Local Levers, het bedrijf van Bryan Ubink</li>
          <li><span>KvK</span> {KVK}</li>
          <li><span>Btw</span> NL002405113B91</li>
        </ul>
        <p class="ct-klein">
          Voor een klacht of een vraag over je gegevens: zie de
          <a href="/voorwaarden/">algemene voorwaarden</a> en de
          <a href="/privacy/">privacyverklaring</a>.
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .ct { background: #fafaf8; color: #141413; font-family: 'Plus Jakarta Sans Variable', system-ui, sans-serif; }
  .ct-inner { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

  .ct-hero { padding: 72px 0 44px; text-align: center; }
  .ct h1 {
    font-family: 'Outfit Variable', sans-serif; font-size: clamp(34px, 5.4vw, 50px);
    font-weight: 800; line-height: 1.08; letter-spacing: -.03em; margin: 0;
  }
  .ct-regel {
    font-style: italic; font-size: clamp(17px, 2vw, 20px); line-height: 1.55;
    color: #3c3c39; margin: 20px auto 0; max-width: 54ch;
  }
  .ct-knop {
    display: inline-flex; align-items: center; gap: 9px; margin-top: 30px;
    background: var(--green); color: #fff; font-family: 'Outfit Variable', sans-serif;
    font-weight: 600; font-size: 17px; letter-spacing: -.005em;
    padding: 16px 32px; border-radius: 4px; text-decoration: none; transition: background .16s ease;
  }
  .ct-knop:hover { background: #1f9067; }

  .ct-blok { padding: 0 0 24px; }
  .ct-wegen { display: grid; gap: 20px; }
  .ct-weg { background: #fff; border: 1px solid #e4e3dc; border-radius: 8px; padding: 34px 32px; }
  .ct-weg h2 {
    font-family: 'Outfit Variable', sans-serif; font-size: 22px; font-weight: 700;
    letter-spacing: -.02em; margin: 0;
  }
  .ct-weg p { font-size: 16px; line-height: 1.6; color: #64645f; margin: 10px 0 0; }
  .ct-groot {
    display: inline-block; margin-top: 16px; font-family: 'Outfit Variable', sans-serif;
    font-weight: 700; font-size: clamp(17px, 2.4vw, 21px); color: var(--green);
    text-decoration: none; word-break: break-word;
  }
  .ct-groot:hover { text-decoration: underline; }

  .ct-gegevens { list-style: none; margin: 34px 0 0; padding: 0; }
  .ct-gegevens li {
    display: flex; flex-wrap: wrap; gap: 4px 16px; padding: 14px 0;
    border-bottom: 1px solid #e4e3dc; font-size: 16px; color: #3c3c39;
  }
  .ct-gegevens span { min-width: 110px; color: #8c8c87; }
  .ct-klein { font-size: 15px; line-height: 1.6; color: #64645f; margin: 18px 0 0; }
  .ct-klein a { color: var(--green); }

  @media (min-width: 760px) {
    .ct-wegen { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .ct-weg { padding: 24px 20px; }
  }
</style>
