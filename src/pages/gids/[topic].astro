---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import { topics } from '../../data/topics.js';
import { niches } from '../../data/niches.js';
import { metaDescription, pageTitle } from '../../utils/meta.js';

export function getStaticPaths() {
  return topics
    .filter((t) => t.published)
    .map((t) => ({ params: { topic: t.slug }, props: { t } }));
}

const { t } = Astro.props;
const title = pageTitle(t);
const description = metaDescription(t.lead);

// Vaste koppeling uit de data: dit artikel wijst omhoog naar de branchepagina's
// waar het bij hoort (SOP vindbaarheid 3.4). Alleen gepubliceerde branches, want
// de gearchiveerde (klinieken, beauty, makelaars) krijgen geen losse URL meer en
// zouden hier een dode link worden. De slugs blijven in de data staan.
const relatedNiches = (t.niches || [])
  .map((slug) => niches.find((n) => n.slug === slug))
  .filter((n) => n && n.published !== false);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const others = topics.filter((x) => x.published && x.slug !== t.slug).slice(0, 5);

// Categorie en datum boven het artikel, zodat de regel hier hetzelfde is als
// op de kaart in de kennisbank. Dezelfde tabel staat in gids/index.astro,
// inclusief de toelichting waar de datums vandaan komen. Pas ze samen aan.
const CATEGORIE = {
  'Marketing en vindbaarheid per vak': { badge: 'Per vak', datum: '2026-08-09' },
  'Online vindbaarheid en reputatie': { badge: 'Vindbaarheid', datum: '2026-08-16' },
  'Google Maps en lokale ranking': { badge: 'Google Maps', datum: '2026-08-16' },
  'Je Google Bedrijfsprofiel': { badge: 'Bedrijfsprofiel', datum: '2026-08-16' },
  'Reviews en reputatie': { badge: 'Reviews', datum: '2026-08-16' },
  'ChatGPT, Perplexity en directories': { badge: 'AI-zoekhulpen', datum: '2026-08-16' },
  'Kiezen en opvolgen': { badge: 'Opvolging', datum: '2026-08-16' },
  'Veelgestelde vragen': { badge: 'Veelgesteld', datum: '2026-07-06' },
};
const MAANDEN = [
  'januari', 'februari', 'maart', 'april', 'mei', 'juni',
  'juli', 'augustus', 'september', 'oktober', 'november', 'december',
];
const meta = CATEGORIE[t.group] || { badge: 'Gids', datum: '2026-07-06' };
const [dJaar, dMaand, dDag] = meta.datum.split('-');
const datumTekst = `${Number(dDag)} ${MAANDEN[Number(dMaand) - 1]} ${dJaar}`;

// Zelfde datum als de zichtbare regel hierboven, zodat het schema en de pagina
// niet uit elkaar kunnen lopen. Er is één datum per categorie, dus alleen
// datePublished: een aparte wijzigingsdatum wordt nergens bijgehouden.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: t.h1,
  description,
  datePublished: meta.datum,
  author: { '@type': 'Organization', name: 'Local Levers' },
  publisher: { '@type': 'Organization', name: 'Local Levers' },
};
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  </Fragment>

  <SiteNav />

  <main class="pg">
    <section class="pg-hero">
      <div class="pg-inner narrow">
        <p class="pg-meta">
          <span class="pg-badge">{meta.badge}</span>
          <span class="pg-datum">{datumTekst}</span>
        </p>
        <h1>{t.h1}</h1>
        <p class="pg-auteur">Door Bryan Ubink</p>
        <p class="pg-lead">{t.lead}</p>
        <a data-cta={`gids-${t.slug}`} href="/gesprek/" class="pg-cta">Plan een gesprek</a>
      </div>
    </section>

    <article class="pg-block">
      <div class="pg-inner narrow prose">
        {/* set:html zodat een sectie-alinea een interne link mag bevatten
            (SOP vindbaarheid 3.4). De lead blijft platte tekst, want daar
            wordt de meta description uit afgeleid. */}
        {t.sections.map((s) => (
          <>
            <h2>{s.h}</h2>
            <p set:html={s.p} />
          </>
        ))}
      </div>
    </article>

    {relatedNiches.length > 0 && (
      <section class="pg-block">
        <div class="pg-inner narrow">
          <h2>De branches waar we ons op richten</h2>
          <p class="pg-lead">Dezelfde principes, maar de winstgevende dienst en de concurrentie verschillen per type bedrijf. Op deze pagina's staat per branche waar klanten blijven liggen en hoe wij dat oplossen.</p>
          <div class="pg-nichegrid">
            {relatedNiches.map((n) => (
              <a href={`/marketing/${n.slug}/`}>
                <span class="pg-nichelabel">{n.h1}</span>
                <span class="pg-nichearrow">&rarr;</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="pg-block">
      <div class="pg-inner narrow pg-faq">
        <h2>Veelgestelde vragen</h2>
        {t.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="pg-block pg-cta-block">
      <div class="pg-inner narrow">
        <h2>Alles in één systeem, voor €397 per maand</h2>
        <p class="pg-lead">Gevonden worden op Google, Bing, Apple en de AI-zoekhulpen. Gekozen worden met een review-systeem op je bestaande klantenlijst. Geboekt worden via je website, een chat die de juiste boekingslink geeft en een terugbelbericht bij een gemiste oproep. €397 ex btw per maand, geen opstartkosten, maandelijks opzegbaar.</p>
        <a data-cta={`gids-slot-${t.slug}`} href="/gesprek/" class="pg-cta">Plan een gesprek</a>
      </div>
    </section>

  </main>
</Layout>

<style>
  .pg { background: #FAFAF8; color: #0a0a09; font-family: 'Plus Jakarta Sans Variable', system-ui, sans-serif; }
  .pg-inner { max-width: 940px; margin: 0 auto; padding: 0 24px; }
  .pg-inner.narrow { max-width: 760px; }
  .pg-hero { padding: 56px 0 48px; background: radial-gradient(700px circle at 80% 0%, rgba(26,122,84,0.08), transparent 55%), #FAFAF8; }
  .pg-eyebrow { font-family: 'Outfit Variable', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #1A7A54; }
  .pg-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .pg-badge { font-family: 'Outfit Variable', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #FFFFFF; background: #1A7A54; border-radius: 999px; padding: 3px 10px; }
  .pg-datum { font-size: 13px; color: #8c8c87; }
  .pg-auteur { font-size: 13px; font-style: italic; font-weight: 500; color: #8c8c87; margin-top: 12px; }
  .pg h1 { font-family: 'Outfit Variable', sans-serif; font-size: clamp(30px, 4.6vw, 46px); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; margin: 14px 0 0; }
  .pg-lead { font-size: 17px; line-height: 1.65; color: #64645F; margin-top: 18px; }
  .pg-cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 24px; background: #1A7A54; color: #fff; font-family: 'Outfit Variable', sans-serif; font-weight: 700; font-size: 15.5px; padding: 15px 26px; border-radius: 14px; text-decoration: none; }
  .pg-block { padding: 48px 0; border-top: 1px solid #E4E3DC; }
  .pg h2 { font-family: 'Outfit Variable', sans-serif; font-size: clamp(22px, 3vw, 28px); font-weight: 800; letter-spacing: -0.015em; line-height: 1.2; margin: 0; }
  .prose h2 { margin-top: 34px; }
  .prose h2:first-child { margin-top: 0; }
  .prose p { font-size: 16px; line-height: 1.75; color: #64645F; margin: 12px 0 0; }
  .pg-nichegrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 24px; }
  .pg-nichegrid a { display: flex; align-items: center; justify-content: space-between; gap: 12px; border: 1px solid #E4E3DC; border-radius: 14px; background: #FFFFFF; padding: 16px 18px; text-decoration: none; }
  .pg-nichegrid a:hover { border-color: #1A7A54; }
  .pg-nichelabel { font-family: 'Outfit Variable', sans-serif; font-weight: 700; font-size: 15px; line-height: 1.3; color: #0a0a09; }
  .pg-nichearrow { color: #1A7A54; font-size: 15px; }
  @media (max-width: 620px) { .pg-nichegrid { grid-template-columns: 1fr; } }
  .pg-faq details { border-top: 1px solid #E4E3DC; padding: 18px 0; }
  .pg-faq summary { font-family: 'Outfit Variable', sans-serif; font-weight: 700; font-size: 17px; color: #0a0a09; cursor: pointer; }
  .pg-faq p { font-size: 15px; line-height: 1.65; color: #64645F; margin: 12px 0 0; }
  .pg-cta-block .pg-lead { margin-top: 14px; }
  .pg-footer { padding: 36px 0 64px; border-top: 1px solid #E4E3DC; font-size: 14px; color: #64645F; }
  .pg-more { list-style: none; padding: 0; margin: 12px 0 24px; display: flex; flex-direction: column; gap: 8px; }
  .pg-more a { color: #64645F; text-decoration: underline; text-underline-offset: 3px; }
  .pg-hublinks { margin: 4px 0 20px; font-size: 14px; }
  .pg-hublinks a { color: #1A7A54; text-decoration: none; }
  .pg-back { font-size: 13px; }
</style>
